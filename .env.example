# Copy this file to .env and fill it in. Never commit .env.
PORT=8080
# MongoDB connection string (e.g. a free MongoDB Atlas cluster).
MONGO_URL=
# Any long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Front-end address(es) allowed to call the API.
CLIENT_URL=http://localhost:4173

# Free API key from https://console.groq.com (no credit card needed).
GROQ_API_KEY=

# Free API key from https://trychannel3.com (1,000 free searches a month; price checks are free).
CHANNEL3_API_KEY=

# PayPal sandbox app: https://developer.paypal.com > Apps & Credentials > Sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional
# WATCH_EVERY_MINUTES=30
# DEMO_TOOLS=false   # hides the "simulate a price drop" button
