{
  "name": "waitforit",
  "version": "1.0.0",
  "private": true,
  "description": "An AI shopping agent that waits for the right price and pays with a PayPal hold, never more than you allowed.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "npm run dev --prefix client",
    "dev:all": "concurrently -n api,web -c cyan,magenta \"npm run dev\" \"npm run client\"",
    "build": "npm install --prefix client --include=dev && npm run build --prefix client",
    "test": "node --test --test-concurrency=1 tests/",
    "load-test": "node scripts/load-test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "morgan": "^1.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "autocannon": "^9.0.0",
    "concurrently": "^9.2.5",
    "expect": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
